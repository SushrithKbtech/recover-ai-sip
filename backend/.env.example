# OpenAI-compatible API key used by the LangGraph agent nodes
OPENAI_API_KEY=sk-...

# Optional: override the base URL for an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model used for intent parsing and explanation generation
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed CORS origins for the deployed frontend
CORS_ORIGINS=http://localhost:5173

# MySQL connection string. utf8mb4 is required: amounts are rendered with the
# rupee sign, which is outside MySQL's legacy 3-byte utf8.
DATABASE_URL=mysql+pymysql://recoverai:recoverai@localhost:3306/recoverai?charset=utf8mb4
